<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.Controller">
    <children>

        <!-- Left: drawing area -->
        <Canvas fx:id="canvas" height="500.0" width="600.0" />

        <!-- Center: tools -->
        <VBox prefWidth="140.0" spacing="8.0" style="-fx-background-color: #eeeeee;">
            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
            <children>
                <!-- Top: line width -->
                <Label style="-fx-font-weight: bold;" text="Eina" />
            <RadioButton fx:id="freehandRadio" mnemonicParsing="false" selected="true" text="Traç lliure">
               <toggleGroup>
                  <ToggleGroup fx:id="widthGroup" />
               </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="lineRadio" mnemonicParsing="false" text="Línia" toggleGroup="$widthGroup" />
            <RadioButton fx:id="rectRadio" mnemonicParsing="false" text="Rectangle" toggleGroup="$widthGroup" />
            <Separator prefWidth="200.0" />
            <Label text="Color de la línia" />
            <ColorPicker fx:id="strokePicker" />
            <Label text="Color d'emplenament" />
            <ColorPicker fx:id="fillPicker" />
            <Label text="Ample de la línia" />
            <Slider fx:id="widthSlider" max="50.0" min="1.0" value="3.0" />
                <fx:define>
                    <ToggleGroup fx:id="widthGroup" />
                </fx:define>

                <!-- Push the colors to the bottom -->
                <Region VBox.vgrow="ALWAYS" />
                <Separator />

                <!-- Bottom: predefined colors -->
                <Label style="-fx-font-weight: bold;" text="Colors" />
                <Canvas fx:id="colorsCanvas" height="200.0" width="200.0" />
            <Separator prefWidth="200.0" />
            </children>
        </VBox>

        <!-- Right: objects list (to do) -->
        <VBox prefWidth="160.0">
            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
            <children>
                <Label style="-fx-font-weight: bold;" text="Objectes" />
            <ListView fx:id="shapesList" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
            <Button fx:id="deleteButton" mnemonicParsing="false" text="Eliminar" />
            </children>
        </VBox>

    </children>
</HBox>
